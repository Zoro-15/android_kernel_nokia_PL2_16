# Android 16 BPF and Common Platform Configuration Fragment
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_CGROUP_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y

# Always-On Debug, Recovery UI (fdsan) and SELinux Permissive
CONFIG_CMDLINE="debug.fdsan=warn androidboot.selinux=permissive"
CONFIG_CMDLINE_EXTEND=y
CONFIG_BUILD_ARM64_APPENDED_KERNEL_IMAGE_NAME="Image.gz-dtb"